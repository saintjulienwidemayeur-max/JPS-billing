# Copy to .env.local (local) or set these in Render > Environment. Server-side only: never commit them.

# --- The SAME database as the warehouse app (this is what connects the two) ---
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543), with your database password filled in.
DATABASE_URL=
DATABASE_SSL_VERIFY=
PG_POOL_MAX=

# --- Sign-in: the same people and codes as the warehouse app (they are in the same database) ---
AUTH_SECRET=

# --- Link back to the warehouse app (receipts, customer records) ---
WAREHOUSE_URL=https://your-warehouse-app.onrender.com

# --- E-mail of the invoices (sent by itself, with the PDF) ---
# Through the customer website's `admin-mail` function: the same three values as in the warehouse app.
SUPABASE_URL=
SITE_STAFF_EMAIL=
SITE_STAFF_PASSWORD=

# WhatsApp (WaAPI): the same values as in the main system
WAAPI_TOKEN=
# WAAPI_INSTANCE_ID=
